{
  "project": "Сумська область: ГРВІ, пороги MEM на сезон 2026/27 (тест добору сезонів: 2012-2015 не виключені вручну)",
  "paths": {
    "series_dir": "input/series",
    "territories": "input/territories.csv",
    "output_dir": "output/auto_seasons_test"
  },
  "season": {
    "start_week": 40,
    "end_week": 20,
    "holiday_weeks": [
      52,
      1,
      2
    ],
    "max_seasons": 10
  },
  "placeholder_seasons": [
    "2026/2027"
  ],
  "exclude_seasons": {
    "2015/2016": "пандемічний грип A(H1N1)",
    "2016/2017": "пандемічний грип A(H1N1)",
    "2021/2022": "хвиля омікрону",
    "2022/2023": "продовження омікрону, масова міграція, збої медичної мережі"
  },
  "angle": {
    "min": 2.0,
    "max": 4.0,
    "step": 0.25,
    "default": 2.8,
    "min_seasons_goodness": 5,
    "criterion": "loss",
    "weights": {
      "false_alert": 1,
      "delay": 1
    },
    "truth_angle": 2.8,
    "stability_drop": 0.2
  },
  "small_areas": {
    "angle": "auto",
    "method": "mixture",
    "groups": {
      "reliable_min": 14,
      "limited_min": 6
    },
    "groups_window_seasons": null,
    "angle_rule": "base_below_medium"
  },
  "start_cleaning": {
    "enabled": true,
    "apply_to": "small",
    "mad_multiplier": 2.5,
    "compare_weeks": 8
  },
  "season_selection": {
    "enabled": true,
    "min_seasons": 5,
    "validation_seasons": 5,
    "tolerance": 0
  },
  "season_subsets": {
    "min_seasons": 5
  },
  "validation": {
    "hidden_season_check": true
  },
  "diagnostics": {
    "proportionality": true,
    "multiple_waves": true
  },
  "export": {
    "dashboard_dim_thresholds": true
  },
  "parallel": {
    "workers": 6
  }
}
