{
  "project": "Сумська область",
  "paths": {
    "series_dir": "datasets",
    "territories": "territories.csv",
    "output_dir": "output"
  },
  "season": {
    "start_week": 40,
    "end_week": 20,
    "holiday_weeks": [
      52,
      1,
      2
    ],
    "max_seasons": 10
  },
  "placeholder_seasons": [
    "2026/2027"
  ],
  "exclude_seasons": {},
  "angle": {
    "min": 2.0,
    "max": 4.0,
    "step": 0.25,
    "default": 2.8,
    "min_seasons_goodness": 3,
    "criterion": "loss",
    "weights": {
      "false_alert": 1,
      "delay": 1
    },
    "truth_angle": 2.8,
    "stability_drop": 0.2
  },
  "small_areas": {
    "angle": "auto",
    "method": "mixture",
    "groups": {
      "reliable_min": 14,
      "limited_min": 6
    },
    "groups_window_seasons": null,
    "angle_rule": "base_below_medium"
  },
  "start_cleaning": {
    "enabled": true,
    "apply_to": "small",
    "mad_multiplier": 2.5,
    "compare_weeks": 8
  },
  "season_selection": {
    "enabled": true,
    "min_seasons": 3,
    "era_start": "2023/2024",
    "era_full": 5,
    "not_validation": [
      "2023/2024"
    ],
    "guard_weeks": 1,
    "recommended_min": 5
  },
  "season_subsets": {
    "min_seasons": 5
  },
  "validation": {
    "hidden_season_check": true
  },
  "diagnostics": {
    "proportionality": true,
    "multiple_waves": true
  },
  "export": {
    "dashboard_dim_thresholds": true
  },
  "parallel": {
    "workers": 6
  },
  "exclude_territory_seasons": {}
}